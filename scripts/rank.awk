# Orders "path:line:col:text" lines: source, then tests, then generated code.
# Source lines stream through; tests and generated print once input ends.
# Generated: a marker comment in the file head, before the package clause
# ("Code generated ... DO NOT EDIT.", "@generated", "Generated by ..."), or a
# path that rarely carries one (lock files, go.sum, *.min.js, *.generated.ts).

function generated_path(path) {
    return path ~ /(^|\/)(generated|__generated__)\// ||
        path ~ /\.(gen|generated)\.[jt]sx?$|\.min\.(js|css)$/ ||
        path ~ /(^|\/)(go\.(work\.)?sum|package-lock\.json|pnpm-lock\.yaml|[^\/]*\.lock)$/
}

function generated_head(path,    line, n, found) {
    while (!found && n++ < 40 && (getline line < path) > 0) {
        if (line ~ /^package /) break
        line = tolower(line)
        if (line !~ /^[[:space:]]*(\/\/|#|--|\/\*|\*|<!--)/) continue
        found = line ~ /@generated|auto(matically)?[- ]?generated/ ||
            (line ~ /generated/ && line ~ /do not (edit|modify)/) ||
            line ~ /^[^a-z]*(code |this file (is|was) )?generated (by|from|with|using) /
    }
    close(path)
    return found
}

function tier(path) {
    if (!(path in tiers)) {
        if (generated_path(path) || generated_head(path)) tiers[path] = 3
        else if (path ~ /(_test\.go|_test\.py|_spec\.lua|\.(test|spec)\.[jt]sx?)$|(^|\/)test_[^\/]*\.py$|(^|\/)(tests?|testdata|__tests__)\//) tiers[path] = 2
        else tiers[path] = 1
    }
    return tiers[path]
}

{
    plain = $0
    gsub(/\033\[[0-9;]*m/, "", plain)
    t = tier(substr(plain, 1, index(plain, ":") - 1))
    if (t == 1) {
        print
        fflush()
    } else {
        held[t, ++count[t]] = $0
    }
}

END {
    for (t = 2; t <= 3; t++)
        for (i = 1; i <= count[t]; i++)
            print held[t, i]
}
